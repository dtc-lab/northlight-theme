{%- comment -%} NORTHLIGHT — product details tabs {%- endcomment -%}
<section id="{{ section.settings.anchor | default: section.id }}" class="nl nl--{{ section.settings.tone }}">
  <div class="nl-wrap nl-pad" data-nl-tabs>
    {%- if section.settings.heading != blank -%}
      <div class="nl-head"><h2 class="nl-h2">{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="nl-tabs__list" role="tablist" aria-label="{{ section.settings.heading | default: 'Product details' | escape }}">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="nl-tab"
          role="tab"
          id="nl-tab-{{ block.id }}"
          aria-controls="nl-panel-{{ block.id }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          {{ block.shopify_attributes }}
        >{{ block.settings.label }}</button>
      {%- endfor -%}
    </div>
    {%- for block in section.blocks -%}
      <div class="nl-tabs__panel" role="tabpanel" id="nl-panel-{{ block.id }}" aria-labelledby="nl-tab-{{ block.id }}" {% unless forloop.first %}hidden{% endunless %}>
        <h3 class="nl-h3">{{ block.settings.label }}</h3>
        {{ block.settings.content }}
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 1040 | image_tag: loading: 'lazy', widths: '520, 780, 1040', sizes: '520px' }}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "NL · Tabs",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "details" },
    {
      "type": "select", "id": "tone", "label": "Background", "default": "cream",
      "options": [ { "value": "cream", "label": "White" }, { "value": "sand", "label": "Ice (light grey)" } ]
    },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Ingredients & doses" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Content goes here.</p>" },
        { "type": "image_picker", "id": "image", "label": "Image (e.g. Supplement Facts)" }
      ]
    }
  ],
  "presets": [ { "name": "NL · Tabs", "blocks": [ { "type": "tab" }, { "type": "tab" } ] } ]
}
{% endschema %}
