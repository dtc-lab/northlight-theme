{%- comment -%}
  NORTHLIGHT — card grid. Used for "Benefits" (numbered cards) and "Timeline"
  (kicker cards). Each card is a block.
{%- endcomment -%}
<section id="{{ section.settings.anchor | default: section.id }}" class="nl nl--{{ section.settings.tone }}">
  <div class="nl-wrap nl-pad">
    <div class="nl-head{% if section.settings.center %} nl-head--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<p class="nl-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="nl-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<div class="nl-intro">{{ section.settings.intro }}</div>{%- endif -%}
    </div>

    <div class="nl-grid">
      {%- for block in section.blocks -%}
        <div class="nl-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 160 | image_tag: class: 'nl-card__icon', loading: 'lazy', alt: '' }}
          {%- elsif section.settings.style == 'numbered' -%}
            <span class="nl-card__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- endif -%}
          {%- if block.settings.kicker != blank -%}<span class="nl-card__kicker">{{ block.settings.kicker }}</span>{%- endif -%}
          <h3 class="nl-h3">{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}<p class="nl-note">{{ section.settings.footnote }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "NL · Card grid",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "For menu links, e.g. how → /products/x#how" },
    {
      "type": "select", "id": "tone", "label": "Background", "default": "cream",
      "options": [ { "value": "cream", "label": "Cream" }, { "value": "sand", "label": "Sand" }, { "value": "paper", "label": "White" }, { "value": "dark", "label": "Navy" } ]
    },
    {
      "type": "select", "id": "style", "label": "Card style", "default": "numbered",
      "options": [ { "value": "numbered", "label": "Numbered" }, { "value": "plain", "label": "Plain" } ]
    },
    { "type": "checkbox", "id": "center", "label": "Center heading", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why men choose Northlight" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the second half. Not for the gym bro." },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "footnote", "label": "Footnote" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon (optional)" },
        { "type": "text", "id": "kicker", "label": "Kicker", "info": "Example: Weeks 1–2" },
        { "type": "text", "id": "title", "label": "Title", "default": "Steady energy" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Support for the everyday energy that used to come easy.*" }
      ]
    }
  ],
  "presets": [
    {
      "name": "NL · Card grid",
      "blocks": [ { "type": "card" }, { "type": "card" }, { "type": "card" } ]
    }
  ]
}
{% endschema %}
