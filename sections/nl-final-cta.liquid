{%- comment -%} NORTHLIGHT — closing call to action (scrolls back to the buy box by default) {%- endcomment -%}
<section class="nl nl--gradient">
  <div class="nl-wrap nl-pad">
    <div class="nl-final">
      <span class="nl-final__star">{% render 'nl-icon', name: 'north', size: 40 %}</span>
      <h2 class="nl-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      <a class="nl-btn nl-btn--gold" href="{{ section.settings.link | default: '#buy' }}">{{ section.settings.button }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NL · Final CTA",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your bearing again." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Two capsules a day. Studied ingredients. A guarantee that takes the risk off you." },
    { "type": "text", "id": "button", "label": "Button label", "default": "Choose your supply" },
    { "type": "text", "id": "link", "label": "Button link", "default": "#buy", "info": "#buy scrolls to the buy box" }
  ],
  "presets": [ { "name": "NL · Final CTA" } ]
}
{% endschema %}
