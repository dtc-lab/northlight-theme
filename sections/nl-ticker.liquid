{%- comment -%} NORTHLIGHT — announcement ticker (static centered line, or scrolling marquee) {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="nl-ticker" role="region" aria-label="Announcements">
  {%- if section.settings.scroll -%}
    <div class="nl-ticker__track" style="--nl-speed: {{ section.settings.speed }}s">
      {%- for n in (1..2) -%}
        <div class="nl-ticker__group"{% if n == 2 %} aria-hidden="true"{% endif %}>
          {%- for i in (1..3) -%}
            {%- for block in section.blocks -%}
              <span {% if n == 1 and i == 1 %}{{ block.shopify_attributes }}{% endif %}>{{ block.settings.text }}</span>
              <span class="nl-ticker__sep" aria-hidden="true">✦</span>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="nl-ticker__static">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</a>
        {%- else -%}
          <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {%- endif -%}
        {%- unless forloop.last -%}<span class="nl-ticker__sep" aria-hidden="true">✦</span>{%- endunless -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
{%- endif -%}

{% schema %}
{
  "name": "NL · Ticker",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "scroll", "label": "Scrolling marquee", "default": false },
    { "type": "range", "id": "speed", "label": "Marquee duration", "min": 10, "max": 60, "step": 5, "unit": "s", "default": 30 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free US Shipping" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "NL · Ticker",
      "blocks": [
        { "type": "item", "settings": { "text": "Buy 2, Get 1 Free" } },
        { "type": "item", "settings": { "text": "[90]-Day Money-Back Guarantee" } },
        { "type": "item", "settings": { "text": "Free US Shipping over [$X]" } }
      ]
    }
  ]
}
{% endschema %}
