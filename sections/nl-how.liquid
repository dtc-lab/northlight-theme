{%- comment -%}
  NORTHLIGHT — Why it works: image + intro + connected steps (Start → Consistent → Judge).
{%- endcomment -%}
<section id="{{ section.settings.anchor | default: section.id }}" class="nl nl--{{ section.settings.tone }} nl-how">
  <div class="nl-wrap nl-pad nl-how__grid">
    <div class="nl-how__head">
      {%- if section.settings.eyebrow != blank -%}<p class="nl-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="nl-h2">{{ section.settings.heading }}</h2>
    </div>

    <div class="nl-how__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 560px, 100vw', alt: section.settings.image.alt | default: section.settings.heading }}
      {%- else -%}
        <span class="nl-how__ph" style="background-image: url('{{ 'nl-topographic.svg' | asset_url }}');">
          {% render 'nl-icon', name: 'needle', size: 64 %}
          <span>[Image: jar raised to the sky at dawn]</span>
        </span>
      {%- endif -%}
    </div>

    <div class="nl-how__body">
      {%- if section.settings.intro != blank -%}<div class="nl-how__intro">{{ section.settings.intro }}</div>{%- endif -%}

      <ol class="nl-how__steps">
        {%- for block in section.blocks -%}
          <li class="nl-how__step" {{ block.shopify_attributes }}>
            <span class="nl-how__icon" aria-hidden="true">
              {%- if block.settings.icon == 'seal' -%}
                {% render 'nl-seal', days: section.settings.seal_days, style: 'navy', size: 60 %}
              {%- else -%}
                {% render 'nl-icon', name: block.settings.icon, size: 26 %}
              {%- endif -%}
            </span>
            <div class="nl-how__stepbody">
              <p class="nl-how__kicker">{{ section.settings.step_word }} {{ forloop.index }}</p>
              <h3 class="nl-how__title">{{ block.settings.title }}</h3>
              {%- if block.settings.points != blank -%}
                <ul class="nl-how__points">
                  {%- assign nl_lines = block.settings.points | newline_to_br | split: '<br />' -%}
                  {%- for line in nl_lines -%}
                    {%- assign l = line | strip -%}
                    {%- if l != blank -%}<li>{{ l }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NL · Why it works",
  "tag": "div",
  "settings": [
    {
      "type": "select", "id": "tone", "label": "Background", "default": "cream",
      "options": [ { "value": "cream", "label": "White" }, { "value": "sand", "label": "Ice (light grey)" } ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One job. Done every morning." },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Square or 4:5. Man 45–58 with the jar, dawn or blue hour." },
    { "type": "text", "id": "step_word", "label": "Step label", "default": "Step" },
    { "type": "text", "id": "seal_days", "label": "Days on the seal icon", "default": "60" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "how-it-works" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "capsule",
          "options": [
            { "value": "capsule", "label": "Capsule" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "seal", "label": "Guarantee seal" },
            { "value": "dawn", "label": "Dawn" },
            { "value": "compass", "label": "Compass" },
            { "value": "needle", "label": "Needle" },
            { "value": "dial", "label": "Dial" },
            { "value": "shield", "label": "Shield" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Start" },
        { "type": "textarea", "id": "points", "label": "Points", "info": "One per line" }
      ]
    }
  ],
  "presets": [ { "name": "NL · Why it works" } ]
}
{% endschema %}
