{%- comment -%} NORTHLIGHT — FAQ accordion {%- endcomment -%}
<section id="{{ section.settings.anchor | default: section.id }}" class="nl nl--{{ section.settings.tone }}">
  <div class="nl-wrap nl-wrap--narrow nl-pad">
    <div class="nl-head nl-head--center" style="margin-bottom: 24px">
      <h2 class="nl-h2">{{ section.settings.heading }}</h2>
    </div>
    <div class="nl-acc nl-acc--lg">
      {%- for block in section.blocks -%}
        <details class="nl-acc__item" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.question }}</span><span class="nl-acc__icon" aria-hidden="true"></span></summary>
          <div class="nl-acc__body">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NL · FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "faq" },
    {
      "type": "select", "id": "tone", "label": "Background", "default": "cream",
      "options": [ { "value": "cream", "label": "Cream" }, { "value": "sand", "label": "Sand" }, { "value": "paper", "label": "White" } ]
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer goes here.</p>" }
      ]
    }
  ],
  "presets": [ { "name": "NL · FAQ", "blocks": [ { "type": "faq" }, { "type": "faq" }, { "type": "faq" } ] } ]
}
{% endschema %}
