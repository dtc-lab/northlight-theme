{%- comment -%}
  NORTHLIGHT — Buy box (product hero)
  Packs are blocks: each pack carries its own prices and its two Reign checkout
  links (subscription / one-time). The CTA points to the selected combination.
{%- endcomment -%}
{%- liquid
  assign nl_images = product.media | where: 'media_type', 'image'
  assign default_pack = section.settings.default_pack | plus: 0
  if section.settings.enable_subscription
    assign mode = section.settings.default_mode
  else
    assign mode = 'once'
  endif

  assign first_url = ''
  assign first_cadence = ''
  assign first_price = ''
  assign missing_links = false
  assign pack_i = 0
  for block in section.blocks
    if block.type == 'pack'
      assign pack_i = pack_i | plus: 1
      if block.settings.url_once == blank
        assign missing_links = true
      endif
      if section.settings.enable_subscription and block.settings.url_sub == blank
        assign missing_links = true
      endif
      if pack_i == default_pack
        assign first_cadence = block.settings.cadence
        if mode == 'sub'
          assign first_url = block.settings.url_sub
          assign first_price = block.settings.price_sub
        else
          assign first_url = block.settings.url_once
          assign first_price = block.settings.price_once
        endif
      endif
    endif
  endfor
-%}

<section id="buy" class="nl nl-buy" data-nl-buy data-mode="{{ mode }}">
  <div class="nl-wrap nl-buy__grid">

    {%- comment -%} Gallery {%- endcomment -%}
    <div class="nl-gallery">
      <div class="nl-gallery__main">
        {%- if nl_images.size > 0 -%}
          {%- for m in nl_images -%}
            <div class="nl-gallery__slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}">
              {%- if forloop.first -%}
                {{ m.preview_image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 600px, 100vw', loading: 'eager', fetchpriority: 'high', alt: m.alt | default: product.title }}
              {%- else -%}
                {{ m.preview_image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 600px, 100vw', loading: 'lazy', alt: m.alt | default: product.title }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="nl-gallery__placeholder">
            <svg viewBox="0 0 220 320" role="img" aria-label="Northlight jar">
              <rect x="58" y="10" width="104" height="44" rx="3" fill="#0F1B2D"/>
              <rect x="44" y="58" width="132" height="252" rx="6" fill="#0F1B2D"/>
              <rect x="44" y="120" width="132" height="1.5" fill="#45CDB3" opacity=".8"/>
              <path d="M110 140 L114 170 L110 164 L106 170 Z" fill="#CDB27A"/>
              <text x="110" y="200" text-anchor="middle" font-family="Jost, sans-serif" font-weight="500" font-size="15" letter-spacing="3.5" fill="#F3F6F7">NORTHLIGHT</text>
              <text x="110" y="222" text-anchor="middle" font-family="Atkinson Hyperlegible Next, sans-serif" font-weight="700" font-size="7.5" letter-spacing="1.6" fill="#CDB27A">DAILY VITALITY FORMULA</text>
              <text x="110" y="290" text-anchor="middle" font-family="Atkinson Hyperlegible Next, sans-serif" font-size="7" letter-spacing="1" fill="#9AA4AC">60 CAPSULES · 30 SERVINGS</text>
            </svg>
          </div>
        {%- endif -%}
      </div>
      {%- if nl_images.size > 1 -%}
        <div class="nl-gallery__thumbs">
          {%- for m in nl_images limit: 6 -%}
            <button type="button" class="nl-thumb{% if forloop.first %} is-active{% endif %}" data-nl-thumb="{{ forloop.index0 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }}">
              {{ m.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Purchase column {%- endcomment -%}
    <div class="nl-buy__col">
      {%- if section.settings.rating_text != blank -%}
        <p class="nl-rating">
          <span class="nl-rating__stars">
            {%- for i in (1..5) -%}{% render 'nl-icon', name: 'star', size: 16 %}{%- endfor -%}
          </span>
          {{ section.settings.rating_text }}
        </p>
      {%- endif -%}

      <div>
        <h1 class="nl-h1">{{ section.settings.title_override | default: product.title }}</h1>
        {%- if section.settings.subtitle != blank -%}
          <p class="nl-lede">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      <ul class="nl-checks">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            <li {{ block.shopify_attributes }}>{% render 'nl-icon', name: 'check', size: 22 %}<span>{{ block.settings.text }}</span></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <fieldset class="nl-fieldset">
        <legend class="nl-legend">{{ section.settings.packs_heading }}</legend>
        {%- assign pack_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'pack' -%}
            {%- assign pack_i = pack_i | plus: 1 -%}
            <label class="nl-pack{% if pack_i == default_pack %} is-selected{% endif %}" {{ block.shopify_attributes }}>
              <input
                class="nl-sr"
                type="radio"
                name="nl-pack-{{ section.id }}"
                value="{{ block.id }}"
                data-nl-pack
                data-url-sub="{{ block.settings.url_sub | escape }}"
                data-url-once="{{ block.settings.url_once | escape }}"
                data-price-sub="{{ block.settings.price_sub | escape }}"
                data-price-once="{{ block.settings.price_once | escape }}"
                data-cadence="{{ block.settings.cadence | escape }}"
                {% if pack_i == default_pack %}checked{% endif %}
              >
              {%- if block.settings.badge != blank -%}<span class="nl-badge">{{ block.settings.badge }}</span>{%- endif -%}
              {%- if block.settings.image != blank -%}
                <span class="nl-pack__img">{{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', widths: '100, 160, 200', sizes: '76px' }}</span>
              {%- endif -%}
              <span class="nl-pack__body">
                <span class="nl-pack__label">{{ block.settings.label }}</span>
                {%- if section.settings.enable_subscription and block.settings.per_sub != blank -%}
                  <span class="nl-only-sub nl-pack__per">{{ block.settings.per_sub }}</span>
                {%- endif -%}
                {%- if block.settings.per_once != blank -%}
                  <span class="nl-only-once nl-pack__per">{{ block.settings.per_once }}</span>
                {%- endif -%}
                {%- if block.settings.sub != blank -%}<span class="nl-pack__sub">{{ block.settings.sub }}</span>{%- endif -%}
              </span>
              <span class="nl-pack__price">
                {%- if section.settings.enable_subscription -%}
                  <span class="nl-only-sub nl-pack__amount">{{ block.settings.price_sub }}</span>
                  {%- if block.settings.compare_sub != blank -%}
                    <s class="nl-only-sub nl-pack__compare"><span class="nl-sr">Regular price </span>{{ block.settings.compare_sub }}</s>
                  {%- endif -%}
                {%- endif -%}
                <span class="nl-only-once nl-pack__amount">{{ block.settings.price_once }}</span>
                {%- if block.settings.compare_once != blank -%}
                  <s class="nl-only-once nl-pack__compare"><span class="nl-sr">Regular price </span>{{ block.settings.compare_once }}</s>
                {%- endif -%}
              </span>
            </label>
          {%- endif -%}
        {%- endfor -%}
      </fieldset>

      {%- if section.settings.enable_subscription -%}
        <div class="nl-modes" role="radiogroup" aria-label="Purchase option">
          <label class="nl-mode{% if mode == 'sub' %} is-selected{% endif %}">
            <input class="nl-sr" type="radio" name="nl-mode-{{ section.id }}" value="sub" data-nl-mode {% if mode == 'sub' %}checked{% endif %}>
            <span class="nl-mode__label">{{ section.settings.sub_label }}</span>
            <span class="nl-mode__note">{{ section.settings.sub_note }}</span>
          </label>
          <label class="nl-mode{% if mode == 'once' %} is-selected{% endif %}">
            <input class="nl-sr" type="radio" name="nl-mode-{{ section.id }}" value="once" data-nl-mode {% if mode == 'once' %}checked{% endif %}>
            <span class="nl-mode__label">{{ section.settings.once_label }}</span>
            <span class="nl-mode__note">{{ section.settings.once_note }}</span>
          </label>
        </div>

        <p class="nl-disclosure nl-only-sub">
          {%- capture nl_cad -%}<span data-nl-cadence>{{ first_cadence | escape }}</span>{%- endcapture -%}
          {{ section.settings.sub_disclosure | escape | replace: '[CADENCE]', nl_cad }}
          {%- if section.settings.terms_link != blank %} <a href="{{ section.settings.terms_link }}">Subscription Terms</a>
          {%- endif -%}
        </p>
      {%- endif -%}

      <a
        class="nl-btn nl-btn--navy nl-btn--block nl-cta"
        href="{{ first_url | default: '#' }}"
        data-nl-cta
        {% if first_url == blank %}aria-disabled="true"{% endif %}
      >
        <span class="nl-cta__main">
          <span>{{ section.settings.cta_label }}</span>
          {%- if section.settings.show_cta_price -%}<span class="nl-cta__price" data-nl-cta-price>{{ first_price }}</span>{%- endif -%}
        </span>
        {%- if section.settings.cta_note != blank -%}
          <span class="nl-cta__note">{% render 'nl-icon', name: 'shield', size: 16 %}{{ section.settings.cta_note }}</span>
        {%- endif -%}
        <span class="nl-cta__arrow" aria-hidden="true">{% render 'nl-icon', name: 'arrow', size: 22 %}</span>
      </a>
      {%- if request.design_mode and missing_links -%}
        <p class="nl-editor-note">Editor only: add the Reign checkout links (subscription and one-time) in each pack block. Until then the button is inactive.</p>
      {%- endif -%}

      {%- if section.settings.payment_icons != blank -%}
        <div class="nl-pay" aria-label="Accepted payment methods">
          {%- assign nl_pay = section.settings.payment_icons | split: ',' -%}
          {%- for t in nl_pay -%}
            {%- assign t = t | strip -%}
            {%- if t != blank -%}{{ t | payment_type_svg_tag }}{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="nl-assure">
        {%- if section.settings.assure_1 != blank -%}<span>{% render 'nl-icon', name: 'shield', size: 18 %}{{ section.settings.assure_1 }}</span>{%- endif -%}
        {%- if section.settings.assure_2 != blank -%}<span>{% render 'nl-icon', name: 'truck', size: 18 %}{{ section.settings.assure_2 }}</span>{%- endif -%}
        {%- if section.settings.assure_3 != blank -%}<span>{% render 'nl-icon', name: 'lock', size: 18 %}{{ section.settings.assure_3 }}</span>{%- endif -%}
      </div>

      <div class="nl-acc">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <details class="nl-acc__item" {{ block.shopify_attributes }}>
              <summary><span>{{ block.settings.question }}</span><span class="nl-acc__icon" aria-hidden="true"></span></summary>
              <div class="nl-acc__body">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</section>

{% schema %}
{
  "name": "NL · Buy box",
  "tag": "div",
  "class": "nl-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "rating_text", "label": "Rating line", "info": "Example: 4.8 · 312 verified reviews. Leave empty until you have real reviews." },
    { "type": "text", "id": "title_override", "label": "Title (optional)", "info": "Empty = product title" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Shilajit, Tongkat Ali, maca and boron, with every dose on the label. Two capsules a day to support healthy energy and drive.*" },
    { "type": "header", "content": "Packs" },
    { "type": "text", "id": "packs_heading", "label": "Packs heading", "default": "Choose your supply" },
    {
      "type": "select", "id": "default_pack", "label": "Pre-selected pack", "default": "2",
      "options": [ { "value": "1", "label": "1st pack" }, { "value": "2", "label": "2nd pack" }, { "value": "3", "label": "3rd pack" } ]
    },
    { "type": "header", "content": "Subscription" },
    { "type": "checkbox", "id": "enable_subscription", "label": "Offer subscription", "default": true },
    {
      "type": "select", "id": "default_mode", "label": "Pre-selected option", "default": "sub",
      "options": [ { "value": "sub", "label": "Subscribe" }, { "value": "once", "label": "One-time" } ]
    },
    { "type": "text", "id": "sub_label", "label": "Subscribe label", "default": "Subscribe & Save [X%]" },
    { "type": "text", "id": "sub_note", "label": "Subscribe note", "default": "Auto-delivery · cancel anytime" },
    { "type": "text", "id": "once_label", "label": "One-time label", "default": "One-time purchase" },
    { "type": "text", "id": "once_note", "label": "One-time note", "default": "No subscription" },
    {
      "type": "textarea", "id": "sub_disclosure", "label": "Subscription disclosure",
      "default": "Renews every [CADENCE] at the subscription price shown until you cancel. We email you before every charge. Skip, pause or cancel online anytime.",
      "info": "[CADENCE] is replaced by the selected pack's cadence. Keep this visible next to the button (auto-renewal laws)."
    },
    { "type": "url", "id": "terms_link", "label": "Subscription Terms page" },
    { "type": "header", "content": "Button & assurances" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Continue to checkout" },
    { "type": "checkbox", "id": "show_cta_price", "label": "Show selected price on the button", "default": true },
    { "type": "text", "id": "cta_note", "label": "Line under the button label", "default": "[90]-day money-back guarantee" },
    {
      "type": "text", "id": "payment_icons", "label": "Payment icons",
      "info": "Comma-separated, only what Reign accepts. Example: visa, master, american_express, discover, apple_pay, google_pay, paypal"
    },
    { "type": "text", "id": "assure_1", "label": "Assurance 1", "default": "[90]-day money-back guarantee" },
    { "type": "text", "id": "assure_2", "label": "Assurance 2", "default": "Ships from the US in 1–2 days" },
    { "type": "text", "id": "assure_3", "label": "Assurance 3", "default": "Secure checkout" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Supports healthy energy and drive*" }
      ]
    },
    {
      "type": "pack",
      "name": "Pack",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "label", "label": "Name", "default": "3 Bottles" },
        { "type": "text", "id": "sub", "label": "Detail", "default": "90-day supply" },
        { "type": "image_picker", "id": "image", "label": "Pack image", "info": "Square, transparent or light background" },
        { "type": "text", "id": "badge", "label": "Badge", "info": "Example: Most Popular" },
        { "type": "text", "id": "cadence", "label": "Renewal cadence", "default": "90 days", "info": "Used in the subscription disclosure" },
        { "type": "header", "content": "Subscription" },
        { "type": "text", "id": "price_sub", "label": "Price", "default": "$[PRICE]" },
        { "type": "text", "id": "compare_sub", "label": "Compare-at price (struck through)", "info": "Leave empty to hide. Only a price you actually charge." },
        { "type": "text", "id": "per_sub", "label": "Per bottle", "default": "$[XX] / bottle" },
        { "type": "url", "id": "url_sub", "label": "Reign checkout link" },
        { "type": "header", "content": "One-time" },
        { "type": "text", "id": "price_once", "label": "Price", "default": "$[PRICE]" },
        { "type": "text", "id": "compare_once", "label": "Compare-at price (struck through)", "info": "Leave empty to hide. Only a price you actually charge." },
        { "type": "text", "id": "per_once", "label": "Per bottle", "default": "$[XX] / bottle" },
        { "type": "url", "id": "url_once", "label": "Reign checkout link" }
      ]
    },
    {
      "type": "faq",
      "name": "Quick question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does it work?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer goes here.</p>" }
      ]
    }
  ],
  "presets": [ { "name": "NL · Buy box" } ]
}
{% endschema %}
