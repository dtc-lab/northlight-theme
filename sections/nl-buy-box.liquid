{%- comment -%}
  NORTHLIGHT — Buy box (product hero)
  Packs are blocks: each pack carries its own prices and its two Reign checkout
  links (subscription / one-time). The CTA points to the selected combination.
{%- endcomment -%}
{%- liquid
  assign nl_images = product.media | where: 'media_type', 'image'
  assign default_pack = section.settings.default_pack | plus: 0
  if section.settings.enable_subscription
    assign mode = section.settings.default_mode
  else
    assign mode = 'once'
  endif

  assign first_url = ''
  assign first_cadence = ''
  assign first_price = ''
  assign missing_links = false
  assign pack_i = 0
  for block in section.blocks
    if block.type == 'pack'
      assign pack_i = pack_i | plus: 1
      if block.settings.url_once == blank
        assign missing_links = true
      endif
      if section.settings.enable_subscription and block.settings.url_sub == blank
        assign missing_links = true
      endif
      if pack_i == default_pack
        assign first_cadence = block.settings.cadence
        if mode == 'sub'
          assign first_url = block.settings.url_sub
          assign first_price = block.settings.price_sub
        else
          assign first_url = block.settings.url_once
          assign first_price = block.settings.price_once
        endif
      endif
    endif
  endfor
  assign split = false
  if section.settings.hero_layout == 'split'
    assign split = true
  endif
-%}

{%- capture nl_benefits -%}
  <ul class="nl-benefits">
    {%- for block in section.blocks -%}
      {%- if block.type == 'benefit' -%}
        <li {{ block.shopify_attributes }}>
          <span class="nl-benefits__icon" aria-hidden="true">
            {%- if block.settings.icon_image != blank -%}
              {{ block.settings.icon_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', width: 24, height: 24 }}
            {%- else -%}
              {% render 'nl-icon', name: block.settings.icon, size: 22 %}
            {%- endif -%}
          </span>
          <span class="nl-benefits__text">
            <strong>{{ block.settings.text }}</strong>
            {%- if block.settings.detail != blank -%}<span>{{ block.settings.detail }}</span>{%- endif -%}
          </span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endcapture -%}

<section id="buy" class="nl nl-buy{% if split %} nl-buy--split nl-buy--{{ section.settings.hero_theme }}{% endif %}" data-nl-buy data-mode="{{ mode }}">
  <div class="nl-wrap nl-buy__grid">

    {%- comment -%} Gallery {%- endcomment -%}
    <div class="nl-gallery">
      <div class="nl-gallery__main">
        {%- if nl_images.size > 0 -%}
          {%- for m in nl_images -%}
            <div class="nl-gallery__slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}">
              {%- if forloop.first -%}
                {{ m.preview_image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 600px, 100vw', loading: 'eager', fetchpriority: 'high', alt: m.alt | default: product.title }}
              {%- else -%}
                {{ m.preview_image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 600px, 100vw', loading: 'lazy', alt: m.alt | default: product.title }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="nl-gallery__placeholder">
            <svg viewBox="0 0 220 320" role="img" aria-label="Northlight jar">
              <rect x="58" y="10" width="104" height="44" rx="3" fill="#0F1B2D"/>
              <rect x="44" y="58" width="132" height="252" rx="6" fill="#0F1B2D"/>
              <rect x="44" y="120" width="132" height="1.5" fill="#45CDB3" opacity=".8"/>
              <path d="M110 140 L114 170 L110 164 L106 170 Z" fill="#CDB27A"/>
              <text x="110" y="200" text-anchor="middle" font-family="Jost, sans-serif" font-weight="500" font-size="15" letter-spacing="3.5" fill="#F3F6F7">NORTHLIGHT</text>
              <text x="110" y="222" text-anchor="middle" font-family="Atkinson Hyperlegible Next, sans-serif" font-weight="700" font-size="7.5" letter-spacing="1.6" fill="#CDB27A">DAILY VITALITY FORMULA</text>
              <text x="110" y="290" text-anchor="middle" font-family="Atkinson Hyperlegible Next, sans-serif" font-size="7" letter-spacing="1" fill="#9AA4AC">60 CAPSULES · 30 SERVINGS</text>
            </svg>
          </div>
        {%- endif -%}
      </div>
      {%- if nl_images.size > 1 -%}
        <div class="nl-gallery__thumbs">
          {%- for m in nl_images limit: 6 -%}
            <button type="button" class="nl-thumb{% if forloop.first %} is-active{% endif %}" data-nl-thumb="{{ forloop.index0 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }}">
              {{ m.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if split -%}<div class="nl-benbox nl-benbox--d">{{ nl_benefits }}</div>{%- endif -%}
    </div>

    {%- comment -%} Purchase column {%- endcomment -%}
    <div class="nl-buy__col">
      {%- liquid
        assign nl_rating_text = section.settings.rating_text
        assign nl_r = product.metafields.reviews.rating.value
        if nl_r != blank
          assign nl_rv = nl_r.rating | round: 1
          assign nl_rc = product.metafields.reviews.rating_count.value | default: 0
          assign nl_rating_text = nl_rating_text | replace: '[RATING]', nl_rv | replace: '[COUNT]', nl_rc
        endif
      -%}
      {%- if nl_rating_text != blank -%}
        <a class="nl-rating" href="{{ section.settings.rating_link | default: '#reviews' }}">
          <span class="nl-rating__stars" aria-hidden="true">
            {%- for i in (1..5) -%}{% render 'nl-icon', name: 'star', size: 18 %}{%- endfor -%}
          </span>
          {%- if section.settings.avatar_1 != blank or section.settings.avatar_2 != blank or section.settings.avatar_3 != blank -%}
            <span class="nl-rating__faces" aria-hidden="true">
              {%- for n in (1..3) -%}
                {%- assign key = 'avatar_' | append: n -%}
                {%- assign face = section.settings[key] -%}
                {%- if face != blank -%}{{ face | image_url: width: 96 | image_tag: loading: 'eager', alt: '', width: 32, height: 32 }}{%- endif -%}
              {%- endfor -%}
            </span>
          {%- endif -%}
          <span>{{ nl_rating_text }}</span>
        </a>
      {%- endif -%}

      <div>
        <h1 class="nl-h1">{{ section.settings.title_override | default: product.title }}</h1>
        {%- if section.settings.subtitle != blank -%}
          <p class="nl-lede">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>

      {%- if split -%}
        {%- assign pack_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'pack' -%}
            {%- assign pack_i = pack_i | plus: 1 -%}
            {%- if pack_i == default_pack -%}
              {%- if mode == 'sub' -%}
                {%- assign s_per = block.settings.per_sub | default: block.settings.price_sub -%}
                {%- assign s_cmp = block.settings.compare_sub -%}
              {%- else -%}
                {%- assign s_per = block.settings.per_once | default: block.settings.price_once -%}
                {%- assign s_cmp = block.settings.compare_once -%}
              {%- endif -%}
              <p class="nl-sum">
                <span class="nl-sum__per" data-nl-sum-per>{{ s_per }}</span>
                <s class="nl-sum__cmp" data-nl-sum-cmp>{{ s_cmp }}</s>
                <span class="nl-sum__save" data-nl-sum-save{% if block.settings.save_text == blank %} hidden{% endif %}>{{ block.settings.save_text }}</span>
              </p>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <div class="nl-benbox nl-benbox--m">{{ nl_benefits }}</div>
      {%- else -%}
        {{ nl_benefits }}
      {%- endif -%}

      {%- if split and section.settings.enable_subscription -%}
        <div class="nl-modetabs" role="group" aria-label="Purchase option">
          <button type="button" class="nl-modetabs__tab" data-nl-mode-set="sub" aria-pressed="{% if mode == 'sub' %}true{% else %}false{% endif %}">{{ section.settings.split_sub_tab }}</button>
          <button type="button" class="nl-modetabs__tab" data-nl-mode-set="once" aria-pressed="{% if mode == 'once' %}true{% else %}false{% endif %}">{{ section.settings.split_once_tab }}</button>
        </div>
      {%- endif -%}
      <fieldset class="nl-fieldset" id="nl-packs-{{ section.id }}" data-nl-packs>
        <legend class="nl-legend">{{ section.settings.packs_heading }}</legend>
        {%- assign pack_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'pack' -%}
            {%- assign pack_i = pack_i | plus: 1 -%}
            <label class="nl-pack{% if pack_i == default_pack %} is-selected{% endif %}" {{ block.shopify_attributes }}>
              <input
                class="nl-sr"
                type="radio"
                name="nl-pack-{{ section.id }}"
                value="{{ block.id }}"
                data-nl-pack
                data-url-sub="{{ block.settings.url_sub | escape }}"
                data-url-once="{{ block.settings.url_once | escape }}"
                data-price-sub="{{ block.settings.price_sub | escape }}"
                data-price-once="{{ block.settings.price_once | escape }}"
                data-cadence="{{ block.settings.cadence | escape }}"
                data-per-sub="{{ block.settings.per_sub | default: block.settings.price_sub | escape }}"
                data-per-once="{{ block.settings.per_once | default: block.settings.price_once | escape }}"
                data-cmp-sub="{{ block.settings.compare_sub | escape }}"
                data-cmp-once="{{ block.settings.compare_once | escape }}"
                data-save="{{ block.settings.save_text | escape }}"
                {% if pack_i == default_pack %}checked{% endif %}
              >
              {%- if block.settings.badge != blank -%}<span class="nl-badge">{{ block.settings.badge }}</span>{%- endif -%}
              <span class="nl-pack__row">
              {%- if block.settings.image != blank -%}
                <span class="nl-pack__img">{{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', widths: '100, 160, 200', sizes: '76px' }}</span>
              {%- endif -%}
              <span class="nl-pack__body">
                <span class="nl-pack__label">{{ block.settings.label }}</span>
                {%- if section.settings.enable_subscription and block.settings.per_sub != blank -%}
                  <span class="nl-only-sub nl-pack__per">{{ block.settings.per_sub }}</span>
                {%- endif -%}
                {%- if block.settings.per_once != blank -%}
                  <span class="nl-only-once nl-pack__per">{{ block.settings.per_once }}</span>
                {%- endif -%}
                {%- if block.settings.sub != blank -%}<span class="nl-pack__sub">{{ block.settings.sub }}</span>{%- endif -%}
                {%- if block.settings.save_text != blank -%}<span class="nl-pack__save">{{ block.settings.save_text }}</span>{%- endif -%}
              </span>
              <span class="nl-pack__price">
                {%- if section.settings.enable_subscription -%}
                  <span class="nl-only-sub nl-pack__amount">{{ block.settings.price_sub }}</span>
                  {%- if block.settings.compare_sub != blank -%}
                    <s class="nl-only-sub nl-pack__compare"><span class="nl-sr">Regular price </span>{{ block.settings.compare_sub }}</s>
                  {%- endif -%}
                {%- endif -%}
                <span class="nl-only-once nl-pack__amount">{{ block.settings.price_once }}</span>
                {%- if block.settings.compare_once != blank -%}
                  <s class="nl-only-once nl-pack__compare"><span class="nl-sr">Regular price </span>{{ block.settings.compare_once }}</s>
                {%- endif -%}
              </span>
              </span>
              {%- if block.settings.bonus_title != blank -%}
                <span class="nl-pack__bonus">
                  <span class="nl-pack__covers" aria-hidden="true">
                    {%- assign nl_covers = block.settings.bonus_covers | plus: 0 -%}
                    {%- for n in (1..nl_covers) -%}
                      {%- assign key = 'bonus_image_' | append: n -%}
                      {%- assign cover = block.settings[key] -%}
                      {%- if cover != blank -%}
                        {{ cover | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 45, height: 60 }}
                      {%- else -%}
                        {% render 'nl-ebook-cover' %}
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                  <span class="nl-pack__bonus-text">
                    <span class="nl-pack__bonus-title">{{ block.settings.bonus_title }}</span>
                    {%- if block.settings.bonus_note != blank -%}
                      <span class="nl-pack__bonus-note">{% render 'nl-icon', name: 'gift', size: 18 %}{{ block.settings.bonus_note }}</span>
                    {%- endif -%}
                  </span>
                </span>
              {%- endif -%}
              {%- if split and block.settings.bonus_title != blank -%}
                {%- assign nl_nc = block.settings.bonus_covers | plus: 0 -%}
                <span class="nl-pack__chip">{% render 'nl-icon', name: 'gift', size: 14 %}+{{ nl_nc }} eBook{% if nl_nc > 1 %}s{% endif %}</span>
              {%- endif -%}
            </label>
          {%- endif -%}
        {%- endfor -%}
      </fieldset>

      {%- if split -%}
        <div class="nl-bonusbar" aria-live="polite">
          {%- assign pack_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'pack' -%}
              {%- assign pack_i = pack_i | plus: 1 -%}
              {%- if block.settings.bonus_title != blank -%}
                <div class="nl-bonusbar__item" data-nl-bonus-for="{{ block.id }}" {% unless pack_i == default_pack %}hidden{% endunless %}>
                  <span class="nl-bonusbar__covers" aria-hidden="true">
                    {%- assign nl_covers = block.settings.bonus_covers | plus: 0 -%}
                    {%- for n in (1..nl_covers) -%}
                      {%- assign key = 'bonus_image_' | append: n -%}
                      {%- assign cover = block.settings[key] -%}
                      {%- if cover != blank -%}
                        {{ cover | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 42, height: 56 }}
                      {%- else -%}
                        {% render 'nl-ebook-cover' %}
                      {%- endif -%}
                    {%- endfor -%}
                  </span>
                  <span class="nl-bonusbar__text">
                    {%- if block.settings.bonus_note != blank -%}
                      <span class="nl-bonusbar__note">{% render 'nl-icon', name: 'gift', size: 16 %}{{ block.settings.bonus_note }}</span>
                    {%- endif -%}
                    <span class="nl-bonusbar__title">{{ block.settings.bonus_title }}</span>
                  </span>
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.enable_subscription -%}
        {%- capture nl_cad -%}<span data-nl-cadence>{{ first_cadence | escape }}</span>{%- endcapture -%}
        {%- if split -%}
          <p class="nl-modetabs__note nl-only-sub">{{ section.settings.sub_note | escape | replace: '[CADENCE]', nl_cad }}</p>
        {%- endif -%}
        <label class="nl-subtoggle{% if mode == 'sub' %} is-selected{% endif %}{% if split %} nl-sr{% endif %}">
          <input class="nl-sr" type="checkbox" value="sub" data-nl-mode {% if mode == 'sub' %}checked{% endif %}>
          <span class="nl-subtoggle__box" aria-hidden="true">{% render 'nl-icon', name: 'check', size: 20 %}</span>
          <span class="nl-subtoggle__text">
            <span class="nl-subtoggle__label">{{ section.settings.sub_label }}</span>
            <span class="nl-subtoggle__note">{{ section.settings.sub_note | escape | replace: '[CADENCE]', nl_cad }}</span>
          </span>
        </label>
      {%- endif -%}

      {%- if section.settings.ship_label != blank -%}
        {%- liquid
          assign nl_now = 'now' | date: '%s' | plus: 0
          assign nl_min = section.settings.ship_min | times: 86400 | plus: nl_now
          assign nl_max = section.settings.ship_max | times: 86400 | plus: nl_now
        -%}
        <p class="nl-ship" data-nl-ship data-min="{{ section.settings.ship_min }}" data-max="{{ section.settings.ship_max }}">
          <span class="nl-ship__dot" aria-hidden="true"></span>
          <span>{{ section.settings.ship_label }} <strong data-nl-ship-dates>{{ nl_min | date: '%b %-d' }} – {{ nl_max | date: '%b %-d' }}</strong></span>
        </p>
      {%- endif -%}

      <a
        class="nl-btn nl-btn--navy nl-btn--block nl-cta"
        href="{{ first_url | default: '#' }}"
        data-nl-cta
        {% if first_url == blank %}aria-disabled="true"{% endif %}
      >
        <span class="nl-cta__main">
          <span>{{ section.settings.cta_label }}</span>
          {%- if section.settings.show_cta_price -%}<span class="nl-cta__price" data-nl-cta-price>{{ first_price }}</span>{%- endif -%}
        </span>
        {%- if section.settings.cta_note != blank -%}
          <span class="nl-cta__note">{% render 'nl-icon', name: 'shield', size: 16 %}{{ section.settings.cta_note }}</span>
        {%- endif -%}
        <span class="nl-cta__arrow" aria-hidden="true">{% render 'nl-icon', name: 'arrow', size: 22 %}</span>
      </a>
      {%- if request.design_mode and missing_links -%}
        <p class="nl-editor-note">Editor only: add the Reign checkout links (subscription and one-time) in each pack block. Until then the button is inactive.</p>
      {%- endif -%}

      {%- if split -%}
        <div class="nl-trustgrid">
          {%- assign nl_ti = 'shield,lock,truck' | split: ',' -%}
          {%- for n in (1..3) -%}
            {%- assign tk = 'trust_' | append: n -%}
            {%- if section.settings[tk] != blank -%}
              {%- assign tparts = section.settings[tk] | split: '|' -%}
              <div class="nl-trustgrid__item">
                {% render 'nl-icon', name: nl_ti[forloop.index0], size: 26 %}
                <strong>{{ tparts[0] | strip }}</strong>
                {%- if tparts[1] != blank -%}<span>{{ tparts[1] | strip }}</span>{%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.enable_subscription -%}
        <details class="nl-subdetails nl-only-sub">
          <summary>
            <span>{{ section.settings.details_label }}</span>
            <span class="nl-subdetails__chev" aria-hidden="true"></span>
          </summary>
          <div class="nl-subdetails__body">
            <p>{{ section.settings.sub_disclosure | escape | replace: '[CADENCE]', nl_cad }}</p>
            {%- if section.settings.terms_link != blank -%}
              <p><a href="{{ section.settings.terms_link }}">{{ section.settings.terms_label }}</a></p>
            {%- endif -%}
          </div>
        </details>
      {%- endif -%}

      {%- if section.settings.g_heading != blank and split == false -%}
        <div class="nl-gbox">
          <span class="nl-gbox__seal">
            {%- if section.settings.g_image != blank -%}
              {{ section.settings.g_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: section.settings.g_heading, width: 120, height: 120 }}
            {%- else -%}
              {% render 'nl-seal', days: section.settings.g_days, style: section.settings.g_style, size: 120 %}
            {%- endif -%}
          </span>
          <div class="nl-gbox__text">
            <p class="nl-gbox__title">{{ section.settings.g_heading }}</p>
            {%- if section.settings.g_text != blank -%}<div class="nl-gbox__body">{{ section.settings.g_text }}</div>{%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.payment_icons != blank -%}
        <div class="nl-pay" aria-label="Accepted payment methods">
          {%- assign nl_pay = section.settings.payment_icons | split: ',' -%}
          {%- for t in nl_pay -%}
            {%- assign t = t | strip -%}
            {%- if t != blank -%}{{ t | payment_type_svg_tag }}{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="nl-assure">
        {%- if section.settings.assure_1 != blank -%}<span>{% render 'nl-icon', name: 'shield', size: 18 %}{{ section.settings.assure_1 }}</span>{%- endif -%}
        {%- if section.settings.assure_2 != blank -%}<span>{% render 'nl-icon', name: 'truck', size: 18 %}{{ section.settings.assure_2 }}</span>{%- endif -%}
        {%- if section.settings.assure_3 != blank -%}<span>{% render 'nl-icon', name: 'lock', size: 18 %}{{ section.settings.assure_3 }}</span>{%- endif -%}
      </div>

      {%- liquid
        assign nl_tab_count = 0
        assign nl_faq_count = 0
        for block in section.blocks
          if block.type == 'info_tab'
            assign nl_tab_count = nl_tab_count | plus: 1
          elsif block.type == 'faq'
            assign nl_faq_count = nl_faq_count | plus: 1
          endif
        endfor
      -%}
      {%- capture nl_faq_list -%}
        <div class="nl-acc">
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq' -%}
              <details class="nl-acc__item" {{ block.shopify_attributes }}>
                <summary><span>{{ block.settings.question }}</span><span class="nl-acc__icon" aria-hidden="true"></span></summary>
                <div class="nl-acc__body">{{ block.settings.answer }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endcapture -%}

      {%- if nl_tab_count > 0 -%}
        <div class="nl-itabs" data-nl-tabs>
          <div class="nl-itabs__list" role="tablist" aria-label="Product information">
            {%- assign nl_first = true -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'info_tab' -%}
                <button
                  type="button" class="nl-itabs__tab" role="tab"
                  id="nl-it-{{ block.id }}" aria-controls="nl-ip-{{ block.id }}"
                  aria-selected="{{ nl_first }}" tabindex="{% if nl_first %}0{% else %}-1{% endif %}"
                  {{ block.shopify_attributes }}
                >{{ block.settings.label }}</button>
                {%- assign nl_first = false -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- assign nl_first = true -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'info_tab' -%}
              <div class="nl-itabs__panel" role="tabpanel" id="nl-ip-{{ block.id }}" aria-labelledby="nl-it-{{ block.id }}" {% unless nl_first %}hidden{% endunless %}>
                {%- case block.settings.kind -%}
                  {%- when 'compare' -%}
                    {%- if block.settings.content != blank -%}<div class="nl-itabs__rte">{{ block.settings.content }}</div>{%- endif -%}
                    <table class="nl-itabs__table">
                      <thead><tr><th scope="col"><span class="nl-sr">Feature</span></th><th scope="col" class="nl-itabs__us">{{ block.settings.col_us }}</th><th scope="col">{{ block.settings.col_them }}</th></tr></thead>
                      <tbody>
                        {%- assign nl_rows = block.settings.rows | newline_to_br | split: '<br />' -%}
                        {%- for row in nl_rows -%}
                          {%- assign r = row | strip -%}
                          {%- if r != blank -%}
                            {%- assign cells = r | split: '|' -%}
                            <tr>
                              <th scope="row">{{ cells[0] | strip }}</th>
                              <td class="nl-itabs__yes">{% render 'nl-icon', name: 'check', size: 20 %}<span class="nl-sr">Yes</span></td>
                              <td class="nl-itabs__no">{{ cells[1] | strip | default: '—' }}</td>
                            </tr>
                          {%- endif -%}
                        {%- endfor -%}
                      </tbody>
                    </table>
                  {%- when 'faq' -%}
                    {%- if block.settings.content != blank -%}<div class="nl-itabs__rte">{{ block.settings.content }}</div>{%- endif -%}
                    {{ nl_faq_list }}
                  {%- else -%}
                    <div class="nl-itabs__rte">{{ block.settings.content }}</div>
                {%- endcase -%}
              </div>
              {%- assign nl_first = false -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- elsif nl_faq_count > 0 -%}
        {{ nl_faq_list }}
      {%- endif -%}
    </div>
  </div>

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
  {%- if section.settings.sticky_label != blank -%}
    <div class="nl-sticky" data-nl-sticky hidden>
      <button type="button" class="nl-sticky__pack" data-nl-sticky-packs aria-label="Change bundle">
        <span class="nl-sticky__label" data-nl-sticky-label></span>
        <span class="nl-sticky__price"><span data-nl-sticky-price>{{ first_price }}</span> <s data-nl-sticky-cmp></s></span>
      </button>
      <a class="nl-btn nl-btn--navy nl-sticky__btn" href="{{ first_url | default: '#nl-packs-' | append: section.id }}" data-nl-sticky-link>
        <span>{{ section.settings.sticky_label }}</span>
        {% render 'nl-icon', name: 'arrow', size: 18 %}
      </a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "NL · Buy box",
  "tag": "div",
  "class": "nl-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Hero layout (A/B)" },
    {
      "type": "select", "id": "hero_layout", "label": "Layout", "default": "classic",
      "options": [ { "value": "classic", "label": "Classic (stacked packs)" }, { "value": "split", "label": "Split (packs side by side)" } ]
    },
    {
      "type": "select", "id": "hero_theme", "label": "Split layout: background", "default": "light",
      "options": [ { "value": "light", "label": "Light" }, { "value": "blue", "label": "Northlight blue" } ]
    },
    { "type": "text", "id": "split_sub_tab", "label": "Split: subscription tab", "default": "Subscribe & save" },
    { "type": "text", "id": "split_once_tab", "label": "Split: one-time tab", "default": "One-time purchase" },
    { "type": "text", "id": "trust_1", "label": "Split: trust 1", "default": "60-day guarantee | Full refund, no questions", "info": "Title | detail" },
    { "type": "text", "id": "trust_2", "label": "Split: trust 2", "default": "Secure checkout | Encrypted payment" },
    { "type": "text", "id": "trust_3", "label": "Split: trust 3", "default": "Ships from the US | Arrives in 5–10 days" },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "rating_text", "label": "Rating line", "info": "Example: 4.9 | 312 reviews. With Judge.me installed, [RATING] and [COUNT] are filled automatically from your real reviews. Leave empty to hide." },
    { "type": "url", "id": "rating_link", "label": "Rating link", "info": "Empty = scrolls to #reviews" },
    { "type": "image_picker", "id": "avatar_1", "label": "Reviewer photo 1", "info": "Real customers only, with permission. Square." },
    { "type": "image_picker", "id": "avatar_2", "label": "Reviewer photo 2" },
    { "type": "image_picker", "id": "avatar_3", "label": "Reviewer photo 3" },
    { "type": "text", "id": "title_override", "label": "Title (optional)", "info": "Empty = product title" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Shilajit, Tongkat Ali, maca and boron, with every dose on the label. Two capsules a day to support healthy energy and drive.*" },
    { "type": "header", "content": "Packs" },
    { "type": "text", "id": "packs_heading", "label": "Packs heading", "default": "Choose your supply" },
    {
      "type": "select", "id": "default_pack", "label": "Pre-selected pack", "default": "2",
      "options": [ { "value": "1", "label": "1st pack" }, { "value": "2", "label": "2nd pack" }, { "value": "3", "label": "3rd pack" } ]
    },
    { "type": "header", "content": "Subscription" },
    { "type": "checkbox", "id": "enable_subscription", "label": "Offer subscription", "default": true },
    {
      "type": "select", "id": "default_mode", "label": "Pre-selected option", "default": "sub",
      "options": [ { "value": "sub", "label": "Subscribe" }, { "value": "once", "label": "One-time" } ]
    },
    { "type": "text", "id": "sub_label", "label": "Toggle label", "default": "Save [X%] with automatic refills" },
    {
      "type": "text", "id": "sub_note", "label": "Toggle note",
      "default": "Ships and renews every [CADENCE]. No commitment. Cancel anytime online.",
      "info": "Keep the renewal cadence and 'cancel anytime' here: it is the part of the terms that must stay visible next to the button."
    },
    { "type": "text", "id": "details_label", "label": "Details button", "default": "Subscription details" },
    {
      "type": "textarea", "id": "sub_disclosure", "label": "Subscription disclosure",
      "default": "Renews every [CADENCE] at the subscription price shown until you cancel. We email you before every charge. Skip, pause or cancel online anytime.",
      "info": "Shown when 'Subscription details' is opened. [CADENCE] is replaced by the selected pack's cadence."
    },
    { "type": "url", "id": "terms_link", "label": "Subscription Terms page" },
    { "type": "text", "id": "terms_label", "label": "Terms link text", "default": "Read the full Subscription Terms" },
    { "type": "header", "content": "Button & assurances" },
    { "type": "text", "id": "ship_label", "label": "Delivery line", "default": "Arrives by", "info": "Dates are calculated from today. Leave empty to hide." },
    { "type": "range", "id": "ship_min", "label": "Delivery: earliest (days)", "min": 1, "max": 20, "step": 1, "default": 5 },
    { "type": "range", "id": "ship_max", "label": "Delivery: latest (days)", "min": 1, "max": 30, "step": 1, "default": 10 },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Continue to checkout" },
    { "type": "text", "id": "sticky_label", "label": "Mobile checkout bar button", "default": "Checkout", "info": "Phones: appears once the main button scrolls away; shows the selected bundle and goes straight to checkout. Leave empty to hide." },
    { "type": "checkbox", "id": "show_cta_price", "label": "Show selected price on the button", "default": true },
    { "type": "text", "id": "cta_note", "label": "Line under the button label", "default": "60-day money-back guarantee" },
    {
      "type": "text", "id": "payment_icons", "label": "Payment icons",
      "info": "Comma-separated, only what Reign accepts. Example: visa, master, american_express, discover, apple_pay, google_pay, paypal"
    },
    { "type": "header", "content": "Guarantee box (under the button)" },
    { "type": "image_picker", "id": "g_image", "label": "Seal image", "info": "Empty = built-in Northlight seal" },
    { "type": "text", "id": "g_days", "label": "Days on the built-in seal", "default": "60" },
    {
      "type": "select", "id": "g_style", "label": "Built-in seal style", "default": "navy",
      "options": [ { "value": "navy", "label": "Navy with gold" }, { "value": "gold", "label": "Gold with navy" } ]
    },
    { "type": "text", "id": "g_heading", "label": "Heading", "default": "Feel the difference, or your money back", "info": "Leave empty to hide the box" },
    { "type": "richtext", "id": "g_text", "label": "Text", "default": "<p>Take it daily for 60 days. If it isn’t for you, email us and get a full refund. No questions asked.</p>" },
    { "type": "header", "content": "Assurances" },
    { "type": "text", "id": "assure_1", "label": "Assurance 1" },
    { "type": "text", "id": "assure_2", "label": "Assurance 2", "default": "Ships from the US in 1–2 days" },
    { "type": "text", "id": "assure_3", "label": "Assurance 3", "default": "Secure checkout" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "dawn",
          "options": [
            { "value": "dawn", "label": "Dawn (energy)" },
            { "value": "compass", "label": "Compass (drive)" },
            { "value": "dial", "label": "Dial (focus)" },
            { "value": "mountain", "label": "Mountain (stamina)" },
            { "value": "needle", "label": "Needle (north)" },
            { "value": "capsule", "label": "Capsule" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "ban", "label": "No / free from" },
            { "value": "check", "label": "Check" }
          ]
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon (optional)", "info": "Overrides the icon above. Transparent PNG or SVG, gold line on transparent." },
        { "type": "text", "id": "text", "label": "Text", "default": "Supports healthy energy and drive*" },
        { "type": "text", "id": "detail", "label": "Detail line (optional)" }
      ]
    },
    {
      "type": "pack",
      "name": "Pack",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "label", "label": "Name", "default": "3 Bottles" },
        { "type": "text", "id": "sub", "label": "Detail", "default": "90-day supply" },
        { "type": "image_picker", "id": "image", "label": "Pack image", "info": "Square, transparent or light background" },
        { "type": "text", "id": "badge", "label": "Badge", "info": "Example: Most Popular" },
        { "type": "text", "id": "save_text", "label": "Savings chip", "info": "Example: Save $55. Only real savings vs. the 1-bottle price." },
        { "type": "text", "id": "cadence", "label": "Renewal cadence", "default": "90 days", "info": "Used in the subscription disclosure" },
        { "type": "header", "content": "Bonus eBooks" },
        { "type": "text", "id": "bonus_title", "label": "Bonus title", "info": "Leave empty for no bonus" },
        { "type": "text", "id": "bonus_note", "label": "Bonus note", "info": "Example: Free eBook ($30 value)" },
        {
          "type": "select", "id": "bonus_covers", "label": "Number of covers", "default": "1",
          "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ]
        },
        { "type": "image_picker", "id": "bonus_image_1", "label": "Cover 1", "info": "Empty = generic cover" },
        { "type": "image_picker", "id": "bonus_image_2", "label": "Cover 2" },
        { "type": "header", "content": "Subscription" },
        { "type": "text", "id": "price_sub", "label": "Price", "default": "$[PRICE]" },
        { "type": "text", "id": "compare_sub", "label": "Compare-at price (struck through)", "info": "Leave empty to hide. Only a price you actually charge." },
        { "type": "text", "id": "per_sub", "label": "Per bottle", "default": "$[XX] / bottle" },
        { "type": "url", "id": "url_sub", "label": "Reign checkout link" },
        { "type": "header", "content": "One-time" },
        { "type": "text", "id": "price_once", "label": "Price", "default": "$[PRICE]" },
        { "type": "text", "id": "compare_once", "label": "Compare-at price (struck through)", "info": "Leave empty to hide. Only a price you actually charge." },
        { "type": "text", "id": "per_once", "label": "Per bottle", "default": "$[XX] / bottle" },
        { "type": "url", "id": "url_once", "label": "Reign checkout link" }
      ]
    },
    {
      "type": "info_tab",
      "name": "Info tab",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Product details" },
        {
          "type": "select", "id": "kind", "label": "Tab type", "default": "text",
          "options": [
            { "value": "text", "label": "Text" },
            { "value": "compare", "label": "Comparison table" },
            { "value": "faq", "label": "Quick questions (the Quick question blocks)" }
          ]
        },
        { "type": "richtext", "id": "content", "label": "Text", "info": "For the table and questions tabs this shows above them (optional)." },
        { "type": "text", "id": "col_us", "label": "Table: our column", "default": "Northlight" },
        { "type": "text", "id": "col_them", "label": "Table: other column", "default": "Typical booster" },
        { "type": "textarea", "id": "rows", "label": "Table rows", "info": "One per line: what we do | what others do" }
      ]
    },
    {
      "type": "faq",
      "name": "Quick question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does it work?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer goes here.</p>" }
      ]
    }
  ],
  "presets": [ { "name": "NL · Buy box" } ]
}
{% endschema %}
