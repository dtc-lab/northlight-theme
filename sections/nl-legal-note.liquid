{%- comment -%} NORTHLIGHT — FDA disclaimer + operator line under the footer {%- endcomment -%}
<div class="nl nl-legal">
  <div class="nl-wrap">
    {{ section.settings.text }}
    {%- if section.settings.operator != blank -%}<p>© {{ 'now' | date: '%Y' }} {{ section.settings.operator }}</p>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "NL · Legal note",
  "tag": "div",
  "settings": [
    {
      "type": "richtext", "id": "text", "label": "Disclaimer",
      "default": "<p>*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Consult your physician before use if you have a medical condition or take medication.</p>"
    },
    { "type": "text", "id": "operator", "label": "Operator line", "default": "Northlight. Operated by Carnath Commerce LLC, 525 Randall Ave Ste 100-1047, Cheyenne, WY 82001, USA." }
  ],
  "presets": [ { "name": "NL · Legal note" } ]
}
{% endschema %}
