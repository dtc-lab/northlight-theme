{%- comment -%}
  NORTHLIGHT — footer (navy). Brand + newsletter, two link columns, contact column.
  Column 1 falls back to the store's legal policies when no menu is chosen.
{%- endcomment -%}
<footer class="nl nl-foot">
  <div class="nl-wrap nl-foot__grid">
    <div class="nl-foot__brand">
      {%- assign nl_logo = section.settings.logo | default: settings.logo -%}
      <a href="{{ routes.root_url }}" class="nl-foot__logo" aria-label="{{ shop.name | escape }}">
        {%- if nl_logo != blank -%}
          {{ nl_logo | image_url: width: 520 | image_tag: loading: 'lazy', alt: shop.name, width: section.settings.logo_width, style: 'max-width: 100%; height: auto;' }}
        {%- else -%}
          <span class="nl-foot__wordmark">{{ shop.name | upcase }}</span>
        {%- endif -%}
      </a>
      {%- if section.settings.about != blank -%}<div class="nl-foot__about">{{ section.settings.about }}</div>{%- endif -%}

      {%- if section.settings.newsletter -%}
        {%- form 'customer', id: 'nl-foot-news', class: 'nl-foot__news' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="nl-foot__ok" role="status">{{ section.settings.news_success }}</p>
          {%- else -%}
            <label class="nl-sr" for="nl-foot-email">{{ section.settings.news_placeholder }}</label>
            <input id="nl-foot-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ section.settings.news_placeholder | escape }}">
            <button type="submit" aria-label="Subscribe">{% render 'nl-icon', name: 'arrow', size: 18 %}</button>
            {%- if form.errors -%}<p class="nl-foot__err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
          {%- endif -%}
        {%- endform -%}
      {%- endif -%}
    </div>

    <nav class="nl-foot__col" aria-label="{{ section.settings.col1_heading | escape }}">
      <p class="nl-foot__h">{{ section.settings.col1_heading }}</p>
      <ul>
        {%- if section.settings.col1_menu != blank -%}
          {%- for link in section.settings.col1_menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
        {%- else -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </nav>

    {%- if section.settings.col2_menu != blank -%}
      <nav class="nl-foot__col" aria-label="{{ section.settings.col2_heading | escape }}">
        <p class="nl-foot__h">{{ section.settings.col2_heading }}</p>
        <ul>
          {%- for link in section.settings.col2_menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="nl-foot__col nl-foot__contact">
      <p class="nl-foot__h">{{ section.settings.col3_heading }}</p>
      {%- if section.settings.contact != blank -%}<div class="nl-foot__rte">{{ section.settings.contact }}</div>{%- endif -%}
      {%- if section.settings.email != blank -%}
        <p class="nl-foot__mail">{{ section.settings.email_label }}<br><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
      {%- endif -%}
    </div>
  </div>

  <div class="nl-wrap nl-foot__bottom">
    <p>© {{ 'now' | date: '%Y' }}, {{ section.settings.copyright | default: shop.name }}.</p>
    {%- if section.settings.payment_icons != blank -%}
      <div class="nl-foot__pay" aria-label="Accepted payment methods">
        {%- assign nl_pay = section.settings.payment_icons | split: ',' -%}
        {%- for t in nl_pay -%}{%- assign t = t | strip -%}{%- if t != blank -%}{{ t | payment_type_svg_tag }}{%- endif -%}{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "NL · Footer",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Empty = the theme logo (use the on-dark version)." },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 120, "max": 320, "step": 10, "unit": "px", "default": 210 },
    {
      "type": "richtext", "id": "about", "label": "About text",
      "default": "<p>Northlight is a daily formula for men who have built something and intend to keep it running. Four disclosed ingredients, every dose on the label, every batch third-party tested. Questions? We answer every email.</p>"
    },
    { "type": "checkbox", "id": "newsletter", "label": "Show email signup", "default": true },
    { "type": "text", "id": "news_placeholder", "label": "Email placeholder", "default": "Your email" },
    { "type": "text", "id": "news_success", "label": "Signup success message", "default": "You’re on the list. Watch your inbox." },
    { "type": "header", "content": "Columns" },
    { "type": "text", "id": "col1_heading", "label": "Column 1 heading", "default": "Our policies" },
    { "type": "link_list", "id": "col1_menu", "label": "Column 1 menu", "info": "Empty = the store’s legal policies (Refund, Privacy, Terms, Shipping…)" },
    { "type": "text", "id": "col2_heading", "label": "Column 2 heading", "default": "Useful links" },
    { "type": "link_list", "id": "col2_menu", "label": "Column 2 menu", "info": "Example: About us, Contact, Track your order, Manage subscription, FAQ" },
    { "type": "text", "id": "col3_heading", "label": "Column 3 heading", "default": "Get in touch" },
    {
      "type": "richtext", "id": "contact", "label": "Contact address",
      "default": "<p>Northlight<br>c/o Carnath Commerce LLC<br>525 Randall Ave Ste 100-1047<br>Cheyenne, WY 82001, USA</p>"
    },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email us:" },
    { "type": "text", "id": "email", "label": "Support email", "default": "[support@northlightmen.com]" },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "copyright", "label": "Copyright name", "default": "Northlight" },
    { "type": "text", "id": "payment_icons", "label": "Payment icons", "info": "Comma-separated, only what Reign accepts. Example: visa, master, american_express, discover, apple_pay, google_pay" }
  ],
  "enabled_on": { "groups": ["footer"] },
  "presets": [ { "name": "NL · Footer" } ]
}
{% endschema %}
