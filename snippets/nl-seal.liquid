{%- comment -%}
  Northlight guarantee seal (used when no seal image is uploaded).
  Usage: {% render 'nl-seal', days: '60', size: 104 %}
{%- endcomment -%}
{%- assign s = size | default: 104 -%}
<svg width="{{ s }}" height="{{ s }}" viewBox="0 0 120 120" role="img" aria-label="{{ days }}-day money-back guarantee" focusable="false">
  <defs>
    <linearGradient id="nl-foil-{{ days }}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#EAD7A6"/><stop offset=".48" stop-color="#CDB27A"/><stop offset="1" stop-color="#9C7E45"/>
    </linearGradient>
    <path id="nl-seal-arc-{{ days }}" d="M60 19 a41 41 0 1 1 -0.01 0"/>
  </defs>
  <circle cx="60" cy="60" r="57" fill="#0F1B2D"/>
  <circle cx="60" cy="60" r="53" fill="none" stroke="url(#nl-foil-{{ days }})" stroke-width="1.6"/>
  <circle cx="60" cy="60" r="31" fill="none" stroke="url(#nl-foil-{{ days }})" stroke-width="1"/>
  <text font-family="Atkinson Hyperlegible Next, sans-serif" font-weight="700" font-size="7.4" fill="#CDB27A">
    <textPath href="#nl-seal-arc-{{ days }}" startOffset="0" textLength="252" lengthAdjust="spacing">MONEY-BACK GUARANTEE · MONEY-BACK GUARANTEE ·</textPath>
  </text>
  <path d="M60 31.5l2 7-2-1.3-2 1.3z" fill="#CDB27A"/>
  <text x="60" y="68" text-anchor="middle" font-family="Jost, sans-serif" font-weight="700" font-size="27" fill="#F3F6F7">{{ days }}</text>
  <text x="60" y="80" text-anchor="middle" font-family="Atkinson Hyperlegible Next, sans-serif" font-weight="700" font-size="8.5" letter-spacing="2.4" fill="#CDB27A">DAYS</text>
</svg>
